{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["source", "symbol"],
  "properties": {
    "source": {
      "type": "string",
      "enum": ["yfinance", "fred", "alpha_vantage"],
      "description": "Data source to fetch from"
    },
    "symbol": {
      "type": "string",
      "description": "Ticker symbol (e.g. AAPL), FRED series ID (e.g. GDP), or Alpha Vantage symbol"
    },
    "start_date": {
      "type": "string",
      "description": "Start date in YYYY-MM-DD format"
    },
    "end_date": {
      "type": "string",
      "description": "End date in YYYY-MM-DD format"
    },
    "interval": {
      "type": "string",
      "enum": ["1d", "1wk", "1mo"],
      "default": "1d",
      "description": "Data frequency"
    },
    "cache_path": {
      "type": "string",
      "description": "Directory for caching fetched data"
    },
    "fred_api_key": {
      "type": "string",
      "description": "FRED API key (overrides environment variable)"
    },
    "alpha_vantage_key": {
      "type": "string",
      "description": "Alpha Vantage API key (overrides environment variable)"
    }
  }
}
